# ═══════════════════════════════════════════════════════════
# SEVA SETU — Environment Variables Template
# Copy karke har service mein .env banao
# ═══════════════════════════════════════════════════════════

# ─── DATABASE (Supabase — FREE tier) ───────────────────────
# Supabase se milega: Project → Settings → Database → Connection string → URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOURPROJECTREF.supabase.co:5432/postgres

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=seva-setu-super-secret-change-in-production-min-32-chars

# ─── SMS — BulkSMSIndia (live credentials already hain) ────
BULKSMSIND_USERNAME=amanshivhare
BULKSMSIND_PASSWORD=YOUR_PASSWORD
BULKSMSIND_SENDER=FANTCL
BULKSMSIND_DLT_TEMPLATE_ID=YOUR_TEMPLATE_ID

# ─── CLOUDINARY (live credentials already hain) ────────────
CLOUDINARY_CLOUD_NAME=ddoe9m7yn
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ─── EMAIL (Gmail App Password) ─────────────────────────────
EMAIL_USER=tumhara@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ─── RAZORPAY (live keys — KYC ke baad milenge) ─────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── FIREBASE FCM ───────────────────────────────────────────
FIREBASE_PROJECT_ID=seva-setu-XXXXX
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seva-setu-XXXXX.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── GOOGLE ANALYTICS ───────────────────────────────────────
# Sirf frontend index.html mein G-XXXXXXXXXX replace karo

# ─── PORTS (default values — usually change karne ki zarurat nahi) ───
AUTH_PORT=3001
USER_PORT=3002
WORKER_PORT=3003
BOOKING_PORT=3004
NOTIFICATION_PORT=3005
PAYMENT_PORT=3006
AI_PORT=3007
ADMIN_PORT=3008

NODE_ENV=production
