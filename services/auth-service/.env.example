# Auth Service — Environment Variables
# Yeh file copy karo aur naam badlo .env
# cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://sevasetu_user:sevasetu_pass@localhost:5432/sevasetu

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=seva-setu-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── SMS via MSG91 ─────────────────────────────────────
# Account banao: https://msg91.com (free trial milta hai)
#
# Steps:
#   1. Login → Dashboard → Auth Key copy karo
#   2. SMS → Sender ID register karo (6 letters)
#   3. SMS → Templates → naya template banao:
#        "Your Seva Setu OTP is ##OTP##. Valid for 5 min. Do not share."
#      Variable name: OTP
#   4. DLT registration karwao (TRAI compliance — 1-2 din lagte hai)
#   5. Template approve hone ke baad Template ID copy karo
#   6. Yahan bharo:
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=SEVSTU
# Note: Agar yeh blank chhod do to OTP console mein print hoga (dev mode)
