# SEVA SETU — Production Environment Variables
# Copy to .env.production and fill in real values

# Database
DB_PASSWORD=change-me-strong-password

# JWT — Generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-char-hex-string-from-openssl

# Razorpay (Production keys)
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# MSG91 SMS
MSG91_AUTH_KEY=xxxxx
MSG91_SENDER_ID=SEVSTU

# WhatsApp Business API
WHATSAPP_TOKEN=xxxxx
WHATSAPP_PHONE_ID=xxxxx

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Production URLs (for CORS)
ALLOWED_ORIGINS=https://sevasetu.in,https://www.sevasetu.in
