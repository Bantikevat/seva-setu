# Mobile Web Frontend — Environment variables

# Backend URLs (defaults to localhost if blank)
# VITE_AUTH_API=http://localhost:3001
# VITE_USER_API=http://localhost:3002
# VITE_WORKER_API=http://localhost:3003
# VITE_BOOKING_API=http://localhost:3004
# VITE_NOTIFY_API=http://localhost:3005

# ─── Firebase Cloud Messaging (push notifications) ───
# Setup:
#   1. Firebase Console → Project Settings → General → "Your apps" → Add Web app
#   2. Copy values from "Firebase SDK snippet" → Config
#   3. Project Settings → Cloud Messaging → Web Push certificates → Generate key pair
#   4. Paste VAPID public key as VITE_FIREBASE_VAPID_KEY
# Same project's service-account JSON goes into services/notification-service/.env
#
# Blank chhod do → push notifications disabled, in-app toasts only
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
